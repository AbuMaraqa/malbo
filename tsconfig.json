{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUnusedLocals": true,
        "jsx": "preserve",
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": ["vite/client", "node"],
        "paths": {
            "@/*": ["./resources/js/*"],
            "@modules/*": ["./Modules/*"]
        }
    },
    "include": ["resources/js/**/*", "Modules/*/resources/js/**/*"]
}
