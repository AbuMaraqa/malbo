APP_NAME="Core View"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# docker compose up -d (ports are offset on purpose)
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=core_view_central
DB_USERNAME=core_view
DB_PASSWORD=core_view

TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,core-view.test
TENANCY_BASE_DOMAIN=localhost
TENANCY_DB_PREFIX=tenant_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

CACHE_STORE=redis
CACHE_PREFIX=core_view_cache_
SESSION_DRIVER=redis
SESSION_STORE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

INERTIA_SSR_ENABLED=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
